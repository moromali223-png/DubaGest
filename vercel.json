{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"DubaGest-Android.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/vitrine/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"DubaGest-Android.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/app", "destination": "https://dubagest-app.pages.dev", "permanent": false },
    { "source": "/pwa", "destination": "https://dubagest-app.pages.dev", "permanent": false },
    { "source": "/login", "destination": "https://dubagest-app.pages.dev/login", "permanent": false },
    { "source": "/register", "destination": "https://dubagest-app.pages.dev/register", "permanent": false },
    { "source": "/connexion", "destination": "https://dubagest-app.pages.dev/login", "permanent": false },
    { "source": "/inscription", "destination": "https://dubagest-app.pages.dev/register", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/vitrine/index.html"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "/vitrine/downloads/$1"
    },
    {
      "source": "/((?!vitrine/).*)",
      "destination": "/vitrine/$1"
    }
  ]
}
