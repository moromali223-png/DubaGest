# Configuration des variables d'environnement et secrets Supabase Edge Functions (abonnement-paiement)
#
# À définir via Supabase CLI :
# supabase secrets set LIGDICASH_API_KEY="..." LIGDICASH_API_TOKEN="..." LIGDICASH_ENV="TEST"
#
# Ou dans le Dashboard Supabase Cloud :
# Project Settings > Edge Functions > Secrets

# Environnement LigdiCash : 'TEST' (Sandbox) ou 'PRODUCTION'
LIGDICASH_ENV=TEST

# Clé API LigdiCash (Sandbox ou Live selon LIGDICASH_ENV)
# Obtenue sur https://app.ligdicash.com (Dashboard développeur)
LIGDICASH_API_KEY=votre_cle_api_ligdicash_ici

# Jeton d'autorisation LigdiCash (Bearer Token)
LIGDICASH_API_TOKEN=votre_token_secret_ligdicash_ici

# URL publique de l'application DubaGest (pour les redirections après paiement client)
APP_BASE_URL=https://dubagest.com

# Identifiants Orange Money (quand le canal direct sera ouvert avec l'opérateur)
# ORANGE_MONEY_MERCHANT_KEY=
# ORANGE_MONEY_CLIENT_SECRET=
